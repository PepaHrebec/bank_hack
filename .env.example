# Copy to .env and fill in. run.py reads it on start; .env is git-ignored.
OPENROUTER_API_KEY=sk-or-...
# Any OpenRouter model id that supports tool calling (see openrouter.ai/models).
OPENROUTER_MODEL=
# The model's hidden "thinking" is off (much faster). Set to on to allow it.
# OPENROUTER_REASONING=on
